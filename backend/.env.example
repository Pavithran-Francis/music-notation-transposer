# All settings are optional; shown values are the defaults.
# SMT_DATA_DIR=./data                      # projects, uploads, SQLite database
# SMT_MAX_UPLOAD_MB=50                     # per-file upload limit
# SMT_MAX_PDF_PAGES=40                     # maximum pages per document
# SMT_MAX_IMAGE_PIXELS=80000000            # decompression-bomb guard for images
# SMT_RETENTION_HOURS=24                   # unsaved projects are deleted after this
# SMT_CLEANUP_INTERVAL_MINUTES=30
# SMT_WORKERS=2                            # concurrent background jobs (OMR/rendering)
# SMT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SMT_AUDIVERIS_PATH=/path/to/Audiveris    # auto-detected if unset (tools/, /Applications, /opt/audiveris, PATH)
# SMT_AUDIVERIS_TIMEOUT_PER_PAGE=180
# SMT_MSCORE_PATH=/path/to/mscore          # auto-detected if unset (MuseScore 4/3)
# SMT_MSCORE_TIMEOUT=180
# SMT_OMR_CONFIDENCE_THRESHOLD=0.75        # notes below this are listed for review
# SMT_RENDER_DPI=300                       # PDF rasterisation resolution for OMR
